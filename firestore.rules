rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 🚧 開発用: 認証済みユーザーまたはCloud Functions（管理者権限）のみ全データ読み書き許可
    match /{document=**} {
      allow read, write: if request.auth != null;  // 認証済みユーザー
      allow read, write: if request.auth == null;  // Cloud Functions管理者権限
    }
  }
}