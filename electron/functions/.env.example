# Firebase Functions 環境変数設定例

# Ollama API設定
OLLAMA_URL=http://localhost:11434

# 暗号化キー（32文字以上の安全なキー）
ENCRYPTION_KEY=your-super-secure-32-char-encryption-key-here

# 開発/本番環境フラグ
NODE_ENV=development

# Twitter API制限設定
TWITTER_RATE_LIMIT_REQUESTS_PER_15MIN=300

# ログレベル
LOG_LEVEL=info

# タイムゾーン
TIMEZONE=Asia/Tokyo

# 最大再試行回数
MAX_RETRY_COUNT=3

# Functions実行タイムアウト（秒）
FUNCTION_TIMEOUT_SECONDS=540